{
  "name": "yebeth2k26-festival",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --include=dev --include=optional --no-audit --no-fund",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/frontend-dev.mjs",
    "dev:api": "npm run build:api && node --watch build-server/server/index.js",
    "build:api": "node scripts/backend-build.mjs",
    "build:full": "npm run build && npm run build:api",
    "db:migrate": "npm run build:api && node build-server/server/scripts/migrate.js",
    "storage:provision": "npm run build:api && node build-server/server/scripts/provision.js",
    "admin:create": "npm run build:api && node build-server/server/scripts/admin.js",
    "seed": "npm run build:api && node build-server/server/scripts/seed.js",
    "test": "npm run build:api && node --test --experimental-test-isolation=none build-server/server/tests/integration.test.js",
    "build": "node scripts/frontend-build.mjs",
    "start": "node build-server/server/index.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "preview": "node scripts/frontend-preview.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "multer": "^2.4.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "supertest": "^7.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
