# Copy to .env locally. Never commit real values. Server variables are not exposed to Vite.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Optional PEM CA certificate. Keep TLS verification enabled.
DATABASE_CA=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
STORAGE_BUCKET=festival-gallery
APP_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SESSION_HOURS=8
TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=lax
VITE_API_BASE_URL=/api
VITE_REALTIME_URL=/api/live
